<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GangBeastsHeads</AssemblyName>
    <RootNamespace>GBHeads</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.6.1" IncludeAssets="compile" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.4.21" IncludeAssets="compile" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup>
    <!-- model glowy, tekstura i dzwieki sa wbudowane w dll (jeden plik do wrzucenia do Mods) -->
    <EmbeddedResource Include="assets\*.bin;assets\*.pcm" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
